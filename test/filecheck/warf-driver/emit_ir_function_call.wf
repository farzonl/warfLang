// RUN: %warf --eval "function foo(arg) { arg } foo(10)" --emit-ir | %FileCheck %s

// CHECK: func __main()
// CHECK-NEXT: entry:
// CHECK-NEXT:   %0 = const 10
// CHECK-NEXT:   %1 = call foo %0
// CHECK-NEXT:   ret %1
// CHECK-EMPTY:
// CHECK-NEXT: func foo(%arg)
// CHECK-NEXT: entry:
// CHECK-NEXT:   ret %arg