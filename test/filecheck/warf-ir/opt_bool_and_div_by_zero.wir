// RUN: %warf-ir --opt --emit-ir %s | %FileCheck %s
// RUN: %warf-ir --opt --run %s | %FileCheck %s --check-prefix=RUN-OPT

func __main()
entry:
  %0 = const 10
  %1 = const 0
  %2 = div %0 %1
  %3 = const true
  %4 = not %3
  %5 = const false
  %6 = eq %4 %5
  ret %6

// CHECK: func __main()
// CHECK-NEXT: entry:
// CHECK-NEXT:   %6 = const true
// CHECK-NEXT:   ret %6
// RUN-OPT: true
