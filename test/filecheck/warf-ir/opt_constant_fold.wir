// RUN: %warf-ir --opt %s | %FileCheck %s
// RUN: %warf-ir --opt --emit-ir %s | %FileCheck %s
// RUN: %warf-ir --opt --run %s | %FileCheck %s --check-prefix=RUN-OPT

func __main()
entry:
  %0 = const 2
  %1 = const 3
  %2 = add %0 %1
  %3 = const 4
  %4 = mul %2 %3
  %5 = neg %4
  %6 = const 50
  %7 = add %6 %5
  ret %7

// CHECK: func __main()
// CHECK-NEXT: entry:
// CHECK-NEXT:   %7 = const 30
// CHECK-NEXT:   ret %7
// RUN-OPT: 30
