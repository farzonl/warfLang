// RUN: %warf-ir --run %s | %FileCheck %s --check-prefix=EXEC
// RUN: %warf-ir --opt --run %s | %FileCheck %s --check-prefix=OPT

func __main()
entry:
  %0 = const 10
  %x = store %0
  %1 = const 25
  %x.1 = store %1
  %2 = print %x.1
  %3 = const 5
  %4 = add %x %3
  %5 = print %4
  %6 = const 0
  ret %6

// EXEC: 25
// EXEC-NEXT: 15
// OPT: 25
// OPT-NEXT: 15
