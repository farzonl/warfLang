// REQUIRES: llvm-backend
// RUN: %warf-ir --run %s | %FileCheck %s --check-prefix=EXEC
// RUN: %warf-ir --opt --emit-ir %s | %FileCheck %s --check-prefix=OPT
// RUN: %warf-ir --emit-llvm-ir %s | %FileCheck %s --check-prefix=LLVM

func __main()
entry:
  %0 = const "hello "
  %1 = const "world"
  %2 = add %0 %1
  %3 = print %2
  %4 = eq %2 "hello world"
  ret %4

// EXEC: hello world
// EXEC-NEXT: true

// OPT: func __main()
// OPT: entry:
// OPT-NEXT:   %2 = const "hello world"
// OPT-NEXT:   %3 = print %2
// OPT-NEXT:   %4 = const true
// OPT-NEXT:   ret %4

// LLVM: ; ModuleID = 'warf'
// LLVM: define i32 @__main() {
// LLVM: entry:
// LLVM:   call ptr @malloc(
// LLVM:   call i32 (ptr, ...) @printf(
// LLVM:   call i32 @strcmp(
// LLVM: }
// LLVM: declare ptr @malloc(i64)
// LLVM: declare i32 @printf(ptr, ...)
// LLVM: declare i32 @strcmp(ptr, ptr)
