// REQUIRES: llvm-backend
// RUN: %warfc -o %t.exe %s
// RUN: sh -c '%t.exe; echo $?' | %FileCheck %s

var x = 0
var res = 0

if ((x != 0) && (10 / x > 1)) {
  print(999)
  res += 100
}

if ((x == 0) || (10 / x > 1)) {
  res += 10
}

if (false && (print(888) == 888)) {
  res += 100
}

if (true || (print(777) == 777)) {
  res += 5
}

if (true && (print(42) == 42)) {
  res += 2
}

res

// CHECK: 42
// CHECK-NEXT: 17
