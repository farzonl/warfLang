// REQUIRES: llvm-backend
// RUN: %warfc -h | %FileCheck %s --check-prefix=HELP
// RUN: %warfc -O --emit-ir %s | %FileCheck %s --check-prefix=OPT-IR
// RUN: %warfc --opt --emit-ir %s | %FileCheck %s --check-prefix=OPT-IR
// RUN: %warfc -O -o %t.exe %s
// RUN: %t.exe | %FileCheck %s --check-prefix=EXEC
// RUN: %warfc --opt -o %t2.exe %s
// RUN: %t2.exe | %FileCheck %s --check-prefix=EXEC

// Dead constant expression eliminated, printed constant expression folded
(10 + 20) * 3
print((2 + 3) * 4 - 6 / 2)
0

// HELP: usage: Warfc [-O|--opt]

// OPT-IR: func __main()
// OPT-IR-NEXT: entry:
// OPT-IR-NEXT:   %13 = const 17
// OPT-IR-NEXT:   %14 = print %13
// OPT-IR-NEXT:   %15 = const 0
// OPT-IR-NEXT:   ret %15

// EXEC: 17
