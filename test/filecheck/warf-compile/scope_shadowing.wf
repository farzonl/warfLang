// REQUIRES: llvm-backend
// RUN: %warfc -o %t.exe %s
// RUN: %t.exe | %FileCheck %s

// 1. Two-level shadowing: outer int, inner int
var x: int = 10
{
  let x: int = 25
  print(x)
}
print(x + 5)

// 2. Two-level shadowing across types: outer bool, inner int
var flag: bool = true
{
  let flag: int = 42
  print(flag)
}
if (flag) {
  print(1)
}

// 3. Three-level deep nested shadowing: int -> int -> bool
var depth = 100
{
  var depth = 20
  {
    var depth = true
    if (depth) {
      print(3)
    }
  }
  print(depth)
}
print(depth + 200)

// 4. Shadowing within a function
function test_fn(base: int): int {
  var delta: int = 7
  {
    let delta: int = 50
    base = base + delta
  }
  print(delta)
  return base
}
print(test_fn(500))

// 5. Shadowing within loops
var count: int = 99
for (var i = 0; i < 2; i += 1) {
  let count: int = i * 10
  print(count)
}
print(count)

0

// CHECK: 25
// CHECK-NEXT: 15
// CHECK-NEXT: 42
// CHECK-NEXT: 1
// CHECK-NEXT: 3
// CHECK-NEXT: 20
// CHECK-NEXT: 300
// CHECK-NEXT: 7
// CHECK-NEXT: 550
// CHECK-NEXT: 0
// CHECK-NEXT: 10
// CHECK-NEXT: 99
