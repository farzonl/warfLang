// REQUIRES: llvm-backend
// RUN: %warfc -o %t.exe %s
// RUN: sh -c '%t.exe; echo $?' | %FileCheck %s

function compute(start, limit) {
  value = start
  if (start < limit) {
    value = 4
  } else {
    value = 5
  }
  while (value < limit) {
    value += 1
  }
  for (index = 0; index < 3; index += 1) {
    value += 2
  }
  value
}

compute(0, 7)

// CHECK: 13

