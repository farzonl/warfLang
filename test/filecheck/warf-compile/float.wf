// REQUIRES: llvm-backend
// RUN: %warfc -o %t.exe %s
// RUN: %t.exe | %FileCheck %s

function circle_area(r: float): float {
  let pi: f64 = 3.14
  return pi * r * r
}

let a = circle_area(2.0)
print(a)

var x: float = 10.5
x += 1.5
x -= 2.0
x *= 0.5
x /= 2.0
print(x)
print(-x)

if (x == 2.5) {
  print(1)
}
if (x != 3.5) {
  print(2)
}
if (x < 3.0 && x <= 2.5 && x > 2.0 && x >= 2.5) {
  print(3)
}

0

// CHECK: 12.56
// CHECK-NEXT: 2.5
// CHECK-NEXT: -2.5
// CHECK-NEXT: 1
// CHECK-NEXT: 2
// CHECK-NEXT: 3
