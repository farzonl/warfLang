// RUN: %warf %s | %FileCheck %s

// Untyped function with consistent boolean returns on branches
function is_even_sign(positive: bool) {
  if (positive) {
    return true
  }
  return false
}

print(is_even_sign(true))
print(is_even_sign(false))

// Untyped function with consistent integer returns on branches
function abs_val(n: int) {
  if (n < 0) {
    return -n
  }
  return n
}

print(abs_val(-42))
print(abs_val(100))

// Untyped function with if-else-if consistent branches
function classify(val: int) {
  if (val > 0) {
    return 1
  } else if (val == 0) {
    return 0
  } else {
    return -1
  }
}

print(classify(5))
print(classify(0))
print(classify(-3))

0

// CHECK: true
// CHECK-NEXT: true
// CHECK-NEXT: false
// CHECK-NEXT: false
// CHECK-NEXT: 42
// CHECK-NEXT: 42
// CHECK-NEXT: 100
// CHECK-NEXT: 100
// CHECK-NEXT: 1
// CHECK-NEXT: 1
// CHECK-NEXT: 0
// CHECK-NEXT: 0
// CHECK-NEXT: -1
// CHECK-NEXT: -1
// CHECK-NEXT: 0
