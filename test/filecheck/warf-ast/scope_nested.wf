// RUN: %warf %s --show_tree | %FileCheck %s

scope_value = 1 
{ 
    { 
        scope_value = scope_value + 2 
    } 
} 
scope_value

// Each blank-line-separated statement is parsed and evaluated on its own,
// but a brace-delimited block is buffered across lines as a single statement.
// CHECK: L--CompilationUnit
// CHECK-NEXT: |--ExpressionStatement
// CHECK-NEXT: L--AssignmentExpression
// CHECK-NEXT: |--IdentifierToken
// CHECK-NEXT: scope_value
// CHECK-NEXT: |--EqualsToken
// CHECK-NEXT: L--LiteralExpression
// CHECK-NEXT: L--NumberToken
// CHECK-NEXT: 1
// CHECK-NEXT: L--EndOfFileToken
// CHECK-NEXT: 1

// CHECK: L--CompilationUnit
// CHECK-NEXT: |--BlockStatement
// CHECK-NEXT: |--OpenBraceToken
// CHECK-NEXT: |--BlockStatement
// CHECK-NEXT: |--OpenBraceToken
// CHECK-NEXT: |--ExpressionStatement
// CHECK-NEXT: L--AssignmentExpression
// CHECK-NEXT: |--IdentifierToken
// CHECK-NEXT: scope_value
// CHECK-NEXT: |--EqualsToken
// CHECK-NEXT: L--BinaryExpression
// CHECK-NEXT: |--IdentifierExpression
// CHECK-NEXT: L--IdentifierToken
// CHECK-NEXT: scope_value
// CHECK-NEXT: |--PlusToken
// CHECK-NEXT: L--LiteralExpression
// CHECK-NEXT: L--NumberToken
// CHECK-NEXT: 2
// CHECK-NEXT: L--CloseBraceToken
// CHECK-NEXT: L--CloseBraceToken
// CHECK-NEXT: L--EndOfFileToken
// CHECK-NEXT: 3

// CHECK: L--CompilationUnit
// CHECK-NEXT: |--ExpressionStatement
// CHECK-NEXT: L--IdentifierExpression
// CHECK-NEXT: L--IdentifierToken
// CHECK-NEXT: scope_value
// CHECK-NEXT: L--EndOfFileToken
// CHECK-NEXT: 3
