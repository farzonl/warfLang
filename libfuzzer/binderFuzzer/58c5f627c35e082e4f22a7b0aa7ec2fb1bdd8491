// While loop with break and continue (and non-folded loop variable across labels)
var i = 0
var sum = 0
while (i < 10) {
  i += 1 + 0
  if (i == 3) { continue }
  if (i == 6) { break }
  sum += i
}
print(sum)

// For loop with break and continue
var forSum = 0
for (var k = 0; k < 10; k += 1) {
  if (k == 2) { continue }
  if (k == 5) { break }
  forSum += k
}
print(forSum)

// Do-while loop with break and continue
var n = 0
var doTotal = 0
do {
  n += 1
  if (n == 2) { continue }
  doTotal += 10
  if (n == 4) { break }
} while (n < 10)
print(doTotal)

