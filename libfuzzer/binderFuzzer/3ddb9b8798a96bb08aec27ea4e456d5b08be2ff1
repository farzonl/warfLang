function computeLoopControl(limit: int):int {
  var total = 0
  for (var i = 0; i < limit; i += 1) {
    if (i == 2) {
      continue
    }   total += i
  }

  var count = 0 do {
    count += 1
    if (count == 2) {
      continue
    }
    total += 10
  } while (count < 3)

  return total
}

computeLoopControl(10)