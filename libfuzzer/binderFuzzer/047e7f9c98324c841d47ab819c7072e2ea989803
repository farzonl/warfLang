// If/else, while, for, do-while, break, continue
i = 0 sum = 0
while (i < 10) {
  i += 1
  if (i == 3) { continue }
  if (i == 6) { break }
  sum += i
}
sum

sum2 = 0
for (var k = 0; k < 10; k += 1) {
  if (k == 2) { continue }
  if (k == 5) { break }
  sum2 += k
}
sum2

n = 0 total = 0
do {
  n += 1
  
  total += 10
  if (n == 4) { break }
} while (n < 10)
total

